{
  "name": "software-intelligence-engine",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "description": "Evidence-grounded software intelligence engine: task-driven, cost-aware, type-aware TypeScript analysis",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "software-intelligence": "src/cli/main.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cli": "tsx src/cli/main.ts",
    "bench": "tsx src/benchmark/run.ts",
    "bench:verification": "tsx src/benchmark/verification-benchmark.ts",
    "mirror": "tsx src/lab/cli/mirror.ts",
    "mirror:test": "vitest run tests/lab/"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "vitest": "^2.1.3"
  }
}
